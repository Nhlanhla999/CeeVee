<UserControl x:Class="CeeVee.Views.Templates.ModernTemplate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CeeVee.Converters">

    <UserControl.Resources>

        <!-- ========================================================= -->
        <!-- SECTION VISIBILITY -->
        <!-- ========================================================= -->

        <converters:SectionVisibilityConverter
            x:Key="SectionVisibilityConverter"/>


        <!-- ========================================================= -->
        <!-- COLORS -->
        <!-- ========================================================= -->

        <SolidColorBrush x:Key="DarkBrush"
                         Color="#343332"/>

        <SolidColorBrush x:Key="GoldBrush"
                         Color="#C6A15B"/>

        <SolidColorBrush x:Key="GoldLightBrush"
                         Color="#D4B678"/>

        <SolidColorBrush x:Key="InkBrush"
                         Color="#1A1A1A"/>

        <SolidColorBrush x:Key="MutedBrush"
                         Color="#555555"/>

        <SolidColorBrush x:Key="LineBrush"
                         Color="#E6E0D5"/>

        <SolidColorBrush x:Key="LineDarkBrush"
                         Color="#D9D0C0"/>


        <!-- ========================================================= -->
        <!-- LEFT SECTION TITLE -->
        <!-- ========================================================= -->

        <Style x:Key="LeftTitle"
               TargetType="TextBlock">

            <Setter Property="FontFamily"
                    Value="Arial"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource GoldBrush}"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="TextAlignment"
                    Value="Center"/>

            <Setter Property="Margin"
                    Value="0,0,0,10"/>

        </Style>


        <!-- ========================================================= -->
        <!-- BODY TEXT -->
        <!-- ========================================================= -->

        <Style x:Key="BodyText"
               TargetType="TextBlock">

            <Setter Property="FontFamily"
                    Value="Arial"/>

            <Setter Property="FontSize"
                    Value="20"/>

            <Setter Property="Foreground"
                    Value="{StaticResource MutedBrush}"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

            <Setter Property="LineHeight"
                    Value="12"/>

        </Style>

    </UserControl.Resources>


    <!-- ============================================================= -->
    <!-- CV PAGE -->
    <!-- ============================================================= -->

    <Border x:Name="Paper"
        Width="{Binding PageWidth}"
        MinHeight="{Binding PageHeight}"
        Background="White"
        HorizontalAlignment="Center"
        VerticalAlignment="Top">

        <Grid>


            <!-- ===================================================== -->
            <!-- TWO COLUMNS -->
            <!-- ===================================================== -->

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="220"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ===================================================== -->
            <!-- LEFT SIDE -->
            <!-- ===================================================== -->

            <Border Grid.Column="0"
                    Background="{StaticResource DarkBrush}"
                    Padding="18,28,18,30">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>


                        <!-- ================================================= -->
                        <!-- NAME -->
                        <!-- ================================================= -->

                        <TextBlock
                            FontFamily="Arial"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="{StaticResource GoldBrush}"
                            LineHeight="24"
                            TextWrapping="Wrap">

                            <Run Text="{Binding PersonalDetails.FullName}"/>

                            <LineBreak/>

                            <Run Text="{Binding PersonalDetails.LastName}"/>

                        </TextBlock>


                        <!-- ================================================= -->
                        <!-- PROFESSION -->
                        <!-- ================================================= -->

                        <TextBlock
                            Text="{Binding PersonalDetails.Profession}"
                            FontFamily="Arial"
                            FontSize="8"
                            FontWeight="Bold"
                            Foreground="White"
                            Opacity="0.9"
                            Margin="0,16,0,0"
                            TextWrapping="Wrap"
                            LineHeight="11"/>


                        <!-- ================================================= -->
                        <!-- CONTACT -->
                        <!-- ================================================= -->

                        <StackPanel
                            Margin="0,28,0,28"
                            HorizontalAlignment="Center">


                            <!-- PHONE -->

                            <StackPanel
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16"
                                Visibility="{Binding PersonalDetails.Phone,
                                    Converter={StaticResource SectionVisibilityConverter}}">

                                <Border
                                    Width="28"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="#4A4947"
                                    HorizontalAlignment="Center">

                                    <TextBlock
                                        Text="☎"
                                        Foreground="{StaticResource GoldBrush}"
                                        FontSize="12"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock
                                    Text="{Binding PersonalDetails.Phone}"
                                    FontFamily="Arial"
                                    FontSize="11"
                                    Foreground="White"
                                    Margin="0,6,0,0"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"/>

                            </StackPanel>


                            <!-- LOCATION -->

                            <StackPanel
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16"
                                Visibility="{Binding PersonalDetails.Location,
                                    Converter={StaticResource SectionVisibilityConverter}}">

                                <Border
                                    Width="28"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="#4A4947"
                                    HorizontalAlignment="Center">

                                    <TextBlock
                                        Text="⌖"
                                        Foreground="{StaticResource GoldBrush}"
                                        FontSize="12"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock
                                    Text="{Binding PersonalDetails.Location}"
                                    FontFamily="Arial"
                                    FontSize="11"
                                    Foreground="White"
                                    Margin="0,6,0,0"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"/>

                            </StackPanel>


                            <!-- EMAIL -->

                            <StackPanel
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16"
                                Visibility="{Binding PersonalDetails.Email,
                                    Converter={StaticResource SectionVisibilityConverter}}">

                                <Border
                                    Width="28"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="#4A4947"
                                    HorizontalAlignment="Center">

                                    <TextBlock
                                        Text="✉"
                                        Foreground="{StaticResource GoldBrush}"
                                        FontSize="11"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock
                                    Text="{Binding PersonalDetails.Email}"
                                    FontFamily="Arial"
                                    FontSize="11"
                                    Foreground="White"
                                    Margin="0,6,0,0"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"/>

                            </StackPanel>


                            <!-- LINKEDIN -->

                            <StackPanel
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16"
                                Visibility="{Binding PersonalDetails.LinkedIn,
                                    Converter={StaticResource SectionVisibilityConverter}}">

                                <Border
                                    Width="28"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="#4A4947"
                                    HorizontalAlignment="Center">

                                    <TextBlock
                                        Text="in"
                                        Foreground="{StaticResource GoldBrush}"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock
                                    Text="{Binding PersonalDetails.LinkedIn}"
                                    FontFamily="Arial"
                                    FontSize="11"
                                    Foreground="White"
                                    Margin="0,6,0,0"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"/>

                            </StackPanel>


                            <!-- GITHUB -->

                            <StackPanel
                                HorizontalAlignment="Center"
                                Visibility="{Binding PersonalDetails.Github,
                                    Converter={StaticResource SectionVisibilityConverter}}">

                                <Border
                                    Width="28"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="#4A4947"
                                    HorizontalAlignment="Center">

                                    <TextBlock
                                        Text="GH"
                                        Foreground="{StaticResource GoldBrush}"
                                        FontSize="8"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock
                                    Text="{Binding PersonalDetails.Github}"
                                    FontFamily="Arial"
                                    FontSize="11"
                                    Foreground="White"
                                    Margin="0,6,0,0"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- CORE SKILLS -->
                        <!-- ================================================= -->

                        <StackPanel
                            Visibility="{Binding HasSkills,
                                Converter={StaticResource SectionVisibilityConverter}}">

                            <TextBlock
                                Text="CORE SKILLS"
                                Style="{StaticResource LeftTitle}"/>

                            <Border
                                Height="1"
                                Background="{StaticResource LineDarkBrush}"
                                Opacity="0.4"
                                Margin="0,0,0,12"/>


                            <ItemsControl
                                ItemsSource="{Binding Skills}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <TextBlock
                                            FontFamily="Arial"
                                            FontSize="13"
                                            Foreground="White"
                                            TextWrapping="Wrap"
                                            Margin="0,0,0,6"
                                            TextAlignment="Center">

                                            <Run
                                                Text="{Binding Name}"
                                                FontWeight="Bold"/>

                                        </TextBlock>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- EDUCATION -->
                        <!-- ================================================= -->

                        <StackPanel
                            Margin="0,28,0,0"
                            Visibility="{Binding HasEducations,
                                Converter={StaticResource SectionVisibilityConverter}}">

                            <TextBlock
                                Text="EDUCATION"
                                Style="{StaticResource LeftTitle}"/>

                            <Border
                                Height="1"
                                Background="{StaticResource LineDarkBrush}"
                                Opacity="0.4"
                                Margin="0,0,0,12"/>


                            <ItemsControl
                                ItemsSource="{Binding Educations}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <StackPanel
        Margin="0,0,0,14">

                                            <!-- DEGREE -->

                                            <TextBlock
            Text="{Binding Degree, Mode=OneWay}"
            FontFamily="Arial"
            FontSize="11"
            FontWeight="Bold"
            Foreground="White"
            TextWrapping="Wrap"
            TextAlignment="Center"/>


                                            <!-- INSTITUTION -->

                                            <TextBlock
            Text="{Binding Institution, Mode=OneWay}"
            FontFamily="Arial"
            FontSize="11"
            Foreground="#C8C0B0"
            Margin="0,3,0,0"
            TextWrapping="Wrap"
            TextAlignment="Center"/>


                                            <!-- YEAR / PRESENT -->

                                            <TextBlock
            Text="{Binding YearText, Mode=OneWay}"
            FontFamily="Arial"
            FontSize="11"
            Foreground="#A99E8D"
            Margin="0,2,0,0"
            TextAlignment="Center"/>

                                        </StackPanel>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- LANGUAGES -->
                        <!-- ================================================= -->

                        <StackPanel
                            Margin="0,20,0,0"
                            Visibility="{Binding HasLanguages,
                                Converter={StaticResource SectionVisibilityConverter}}">

                            <TextBlock
                                Text="LANGUAGES"
                                Style="{StaticResource LeftTitle}"/>

                            <Border
                                Height="1"
                                Background="{StaticResource LineDarkBrush}"
                                Opacity="0.4"
                                Margin="0,0,0,10"/>


                            <ItemsControl
                                ItemsSource="{Binding Languages}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontFamily="Arial"
                                            FontSize="13"
                                            Foreground="White"
                                            Margin="0,0,0,4"
                                            TextAlignment="Center"/>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </StackPanel>

                </ScrollViewer>

            </Border>


            <!-- ========================================================= -->
            <!-- RIGHT SIDE -->
            <!-- ========================================================= -->

            <ScrollViewer
                Grid.Column="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <StackPanel
                    Margin="32,24,32,40">


                    <!-- ================================================= -->
                    <!-- PROFESSIONAL SUMMARY -->
                    <!-- ================================================= -->

                    <StackPanel
                        Margin="0,0,0,22"
                        Visibility="{Binding HasProfile,
                            Converter={StaticResource SectionVisibilityConverter}}">

                        <Border
                            Height="1"
                            Background="{StaticResource LineBrush}"
                            Margin="20,0,20,10"/>

                        <TextBlock
                            Text="PROFESSIONAL SUMMARY"
                            FontFamily="Arial"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{StaticResource InkBrush}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"/>

                        <Border
                            Height="1"
                            Background="{StaticResource LineBrush}"
                            Margin="20,10,20,12"/>

                        <TextBlock
                            Text="{Binding Profile.Summary}"
                            FontFamily="Arial"
                            FontSize="14"
                            Foreground="{StaticResource MutedBrush}"
                            TextWrapping="Wrap"
                            LineHeight="13"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- WORK EXPERIENCE -->
                    <!-- ================================================= -->

                    <StackPanel
                        Visibility="{Binding HasExperiences,
                            Converter={StaticResource SectionVisibilityConverter}}">

                        <Border
                            Height="1"
                            Background="{StaticResource LineBrush}"
                            Margin="20,0,20,10"/>

                        <TextBlock
                            Text="WORK EXPERIENCE"
                            FontFamily="Arial"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{StaticResource InkBrush}"
                            HorizontalAlignment="Center"/>

                        <Border
                            Height="1"
                            Background="{StaticResource LineBrush}"
                            Margin="20,10,20,16"/>


                        <ItemsControl
                            ItemsSource="{Binding Experiences}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <StackPanel
                                        Margin="0,0,0,20">

                                        <TextBlock
                                            Text="{Binding JobTitle}"
                                            FontFamily="Arial"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource InkBrush}"
                                            TextWrapping="Wrap"/>


                                        <TextBlock
    FontFamily="Arial"
    FontSize="11"
    Foreground="{StaticResource MutedBrush}"
    Margin="0,2,0,6"
    TextWrapping="Wrap">

    <Run Text="{Binding Company, Mode=OneWay}"/>

    <Run Text=" | "/>

    <Run Text="{Binding StartDateText, Mode=OneWay}"/>

    <Run Text=" – "/>

    <Run Text="{Binding EndDateText, Mode=OneWay}"/>

                                        </TextBlock>

                                        <TextBlock
                                            FontFamily="Arial"
                                            FontSize="14"
                                            Foreground="{StaticResource MutedBrush}"
                                            TextWrapping="Wrap"
                                            LineHeight="12">

                                            <Run Text="• "/>

                                            <Run Text="{Binding Description}"/>

                                        </TextBlock>

                                    </StackPanel>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- PROJECTS -->
                    <!-- ================================================= -->

                    <StackPanel
                        Margin="0,8,0,0"
                        Visibility="{Binding HasProjects,
                            Converter={StaticResource SectionVisibilityConverter}}">

                        <Border
                            Height="1"
                            Background="{StaticResource LineBrush}"
                            Margin="20,0,20,10"/>

                        <TextBlock
                            Text="PROJECTS"
                            FontFamily="Arial"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{StaticResource InkBrush}"
                            HorizontalAlignment="Center"/>

                        <Border
                            Height="1"
                            Background="{StaticResource LineBrush}"
                            Margin="20,10,20,12"/>


                        <ItemsControl
                            ItemsSource="{Binding Projects}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <StackPanel
                                        Margin="0,0,0,10">

                                        <TextBlock
                                            Text="{Binding Title}"
                                            FontFamily="Arial"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource InkBrush}"
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Text="{Binding Description}"
                                            FontFamily="Arial"
                                            FontSize="14"
                                            Foreground="{StaticResource MutedBrush}"
                                            Margin="0,2,0,0"
                                            TextWrapping="Wrap"/>

                                        <TextBlock
                                            Text="{Binding Link}"
                                            FontFamily="Arial"
                                            FontSize="12"
                                            Foreground="{StaticResource MutedBrush}"
                                            Margin="0,3,0,0"
                                            TextWrapping="Wrap"/>

                                    </StackPanel>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- CERTIFICATES -->
                    <!-- ================================================= -->

                    <StackPanel
                        Margin="0,8,0,0"
                        Visibility="{Binding HasCertificates,
                            Converter={StaticResource SectionVisibilityConverter}}">

                        <Border
                            Height="1"
                            Background="{StaticResource LineBrush}"
                            Margin="20,0,20,10"/>

                        <TextBlock
                            Text="CERTIFICATIONS"
                            FontFamily="Arial"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{StaticResource InkBrush}"
                            HorizontalAlignment="Center"/>

                        <Border
                            Height="1"
                            Background="{StaticResource LineBrush}"
                            Margin="20,10,20,12"/>


                        <ItemsControl
                            ItemsSource="{Binding Certificates}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Grid
                                        Margin="0,0,0,8">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>


                                        <StackPanel>

                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontFamily="Arial"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource InkBrush}"
                                                TextWrapping="Wrap"/>

                                            <TextBlock
                                                Text="{Binding Institution}"
                                                FontFamily="Arial"
                                                FontSize="13"
                                                Foreground="{StaticResource MutedBrush}"
                                                Margin="0,2,0,0"
                                                TextWrapping="Wrap"/>

                                        </StackPanel>


                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Year,
                                                   StringFormat={}{0:MMMM yyyy}}"
                                            FontFamily="Arial"
                                            FontSize="13"
                                            Foreground="{StaticResource MutedBrush}"
                                            Margin="12,0,0,0"/>

                                    </Grid>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- ACHIEVEMENTS -->
                    <!-- ================================================= -->

                    <StackPanel
                        Margin="0,8,0,0"
                        Visibility="{Binding HasAchievements,
                            Converter={StaticResource SectionVisibilityConverter}}">

                        <Border
                            Height="1"
                            Background="{StaticResource LineBrush}"
                            Margin="20,0,20,10"/>

                        <TextBlock
                            Text="ACHIEVEMENTS"
                            FontFamily="Arial"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{StaticResource InkBrush}"
                            HorizontalAlignment="Center"/>

                        <Border
                            Height="1"
                            Background="{StaticResource LineBrush}"
                            Margin="20,10,20,12"/>


                        <ItemsControl
                            ItemsSource="{Binding Achievements}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <StackPanel
                                        Margin="0,0,0,10">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="Auto"/>

                                            </Grid.ColumnDefinitions>


                                            <TextBlock
                                                Text="{Binding Title}"
                                                FontFamily="Arial"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource InkBrush}"
                                                TextWrapping="Wrap"/>


                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding Year,
                                                       StringFormat={}{0:MMMM yyyy}}"
                                                FontFamily="Arial"
                                                FontSize="12"
                                                Foreground="{StaticResource MutedBrush}"
                                                Margin="12,0,0,0"/>

                                        </Grid>


                                        <TextBlock
                                            Text="{Binding Description}"
                                            Style="{StaticResource BodyText}"
                                            Margin="0,3,0,0"/>

                                    </StackPanel>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>




                    <!-- ================================================= -->
                    <!-- REFERENCES -->
                    <!-- ================================================= -->

                    <StackPanel
                        Margin="0,8,0,0"
                        Visibility="{Binding HasReferences,
                            Converter={StaticResource SectionVisibilityConverter}}">

                        <Border
                            Height="1"
                            Background="{StaticResource LineBrush}"
                            Margin="20,0,20,10"/>

                        <TextBlock
                            Text="REFERENCES"
                            FontFamily="Arial"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{StaticResource InkBrush}"
                            HorizontalAlignment="Center"/>

                        <Border
                            Height="1"
                            Background="{StaticResource LineBrush}"
                            Margin="20,10,20,12"/>


                        <ItemsControl
                            ItemsSource="{Binding References}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Grid
                                        Margin="0,0,0,16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="150"/>

                                        </Grid.ColumnDefinitions>


                                        <!-- REFERENCE PERSON -->

                                        <StackPanel>

                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontFamily="Arial"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource InkBrush}"
                                                TextWrapping="Wrap"/>

                                            <TextBlock
                                                Text="{Binding Position}"
                                                FontFamily="Arial"
                                                FontSize="12"
                                                Foreground="{StaticResource MutedBrush}"
                                                Margin="0,3,0,0"
                                                TextWrapping="Wrap"/>

                                            <TextBlock
                                                Text="{Binding Company}"
                                                FontFamily="Arial"
                                                FontSize="12"
                                                Foreground="{StaticResource MutedBrush}"
                                                Margin="0,2,0,0"
                                                TextWrapping="Wrap"/>

                                        </StackPanel>


                                        <!-- CONTACT -->

                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Right">

                                            <TextBlock
                                                Text="{Binding Phone}"
                                                FontFamily="Arial"
                                                FontSize="12"
                                                Foreground="{StaticResource MutedBrush}"
                                                TextAlignment="Right"
                                                TextWrapping="Wrap"/>

                                            <TextBlock
                                                Text="{Binding Email}"
                                                FontFamily="Arial"
                                                FontSize="12"
                                                Foreground="{StaticResource MutedBrush}"
                                                TextAlignment="Right"
                                                TextWrapping="Wrap"
                                                Margin="0,3,0,0"/>

                                        </StackPanel>

                                    </Grid>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>


                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Border>

</UserControl>



