<UserControl x:Class="CeeVee.Controls.MonthYearPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="180">

    <UserControl.Resources>

        <!-- ========================================================= -->
        <!-- MAIN PICKER BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="PickerButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#D8D1C7"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="12,10"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"/>

                                <!-- Calendar icon -->

                                <TextBlock
                                    Grid.Column="1"
                                    Text="▣"
                                    FontSize="15"
                                    Foreground="#817A70"
                                    VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="BorderBrush"
                            Value="#A88B5A"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F3F0EA"/>

                </Trigger>

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter Property="Opacity"
                            Value="0.55"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================================= -->
        <!-- MONTH BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="MonthButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#E2DDD5"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Margin"
                    Value="3"/>

            <Setter Property="Padding"
                    Value="5"/>

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F3F0EA"/>

                    <Setter Property="BorderBrush"
                            Value="#A88B5A"/>

                </Trigger>

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter Property="Opacity"
                            Value="0.30"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <Grid>

        <!-- ========================================================= -->
        <!-- PICKER BUTTON -->
        <!-- ========================================================= -->

        <Button
            x:Name="PickerButton"
            Style="{StaticResource PickerButtonStyle}"
            Click="PickerButton_Click">

            <TextBlock
                x:Name="SelectedText"
                Text="Select month and year"
                FontSize="13"
                Foreground="#252321"/>

        </Button>


        <!-- ========================================================= -->
        <!-- CALENDAR-STYLE POPUP -->
        <!-- ========================================================= -->

        <Popup
            x:Name="CalendarPopup"
            PlacementTarget="{Binding ElementName=PickerButton}"
            Placement="Bottom"
            StaysOpen="False"
            AllowsTransparency="True"
            PopupAnimation="Fade">

            <Border
                Background="#FFFFFF"
                BorderBrush="#D8D1C7"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,6,0,0">

                <Border.Effect>

                    <DropShadowEffect
                        BlurRadius="18"
                        ShadowDepth="3"
                        Opacity="0.18"/>

                </Border.Effect>


                <StackPanel Width="290">

                    <!-- ================================================= -->
                    <!-- YEAR NAVIGATION -->
                    <!-- ================================================= -->

                    <Grid Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <!-- Previous year -->

                        <Button
                            Grid.Column="0"
                            Content="‹"
                            Width="38"
                            Height="32"
                            FontSize="20"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#252321"
                            Click="PreviousYear_Click"/>


                        <!-- Year -->

                        <TextBlock
                            x:Name="YearText"
                            Grid.Column="1"
                            Text="2026"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Georgia"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#252321"/>


                        <!-- Next year -->

                        <Button
                            Grid.Column="2"
                            Content="›"
                            Width="38"
                            Height="32"
                            FontSize="20"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#252321"
                            Click="NextYear_Click"/>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- MONTHS -->
                    <!-- ================================================= -->

                    <UniformGrid
                        x:Name="MonthsGrid"
                        Columns="3">

                    </UniformGrid>


                    <!-- ================================================= -->
                    <!-- FOOTER -->
                    <!-- ================================================= -->

                    <Border
                        Background="#F8F6F2"
                        CornerRadius="6"
                        Padding="8"
                        Margin="3,12,3,0">

                        <TextBlock
                            x:Name="FooterText"
                            Text="Select a month"
                            FontSize="11"
                            Foreground="#817A70"
                            HorizontalAlignment="Center"/>

                    </Border>

                </StackPanel>

            </Border>

        </Popup>

    </Grid>

</UserControl>

