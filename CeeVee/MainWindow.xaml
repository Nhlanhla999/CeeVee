                                    HorizontalAlignment="Left"
                                    Click="BackButton_Click"/>


                            <Button x:Name="NextButton"
                                    Grid.Column="1"
                                    Content="Next  →"
                                    Style="{StaticResource GreenButton}"
                                    Click="NextButton_Click"/>

                        </Grid>

                    </Border>

                </Grid>

            </Border>


            <!-- ========================================================= -->
            <!-- LIVE PREVIEW -->
            <!-- ========================================================= -->

            <Border Grid.Column="2"
        Background="#FFFFFF"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        Margin="0,18,18,18">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="72"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- ========================================================= -->
                    <!-- PREVIEW HEADER -->
                    <!-- ========================================================= -->

                    <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">

                        <Grid Margin="20,0">


                            <!-- ================================================= -->
                            <!-- CENTER DOCUMENT SETTINGS -->
                            <!-- ================================================= -->

                            <Grid Width="390"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="140"/>

                                    <ColumnDefinition Width="0"/>

                                    <ColumnDefinition Width="140"/>

                                </Grid.ColumnDefinitions>


                                <!-- ================================================= -->
                                <!-- TEMPLATE -->
                                <!-- ================================================= -->

                                <StackPanel Grid.Column="0"
            Margin="0,0,-10,0">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                   Text="▤"
                   FontFamily="Segoe UI Symbol"
                   FontSize="27"
                   Margin="0,23,2,0"
                   Foreground="{StaticResource Accent}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

                                        <ComboBox Grid.Column="1"
                  x:Name="TemplateComboBox"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="{StaticResource TextPrimary}"
                  FontFamily="Arial"
                  FontSize="11"
                  Height="25"
                  Width="100"
                  FontWeight="SemiBold"
                  Margin="0,25,0,0"
                  VerticalContentAlignment="Center"
                  SelectionChanged="TemplateComboBox_SelectionChanged"
                  ToolTip="Choose a CV template">

                                            <ComboBoxItem Content="Modern"
                          Tag="Modern"
                          Foreground="#24302C"/>

                                            <ComboBoxItem Content="Classic"
                          Tag="Classic"
                          Foreground="#24302C"/>

                                            <ComboBoxItem Content="Minimal"
                          Tag="Minimal"
                          Foreground="#24302C"/>

                                            <ComboBoxItem Content="Corporate"
                          Tag="Corporate"
                          Foreground="#24302C"/>

                                        </ComboBox>

                                    </Grid>

                                </StackPanel>


                                <!-- ================================================= -->
                                <!-- PAGE SIZE -->
                                <!-- ================================================= -->

                                <StackPanel Grid.Column="2"
            Margin="-10,0,0,0">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                   Text="▯"
                   FontFamily="Segoe UI Symbol"
                   FontSize="25"
                   Margin="0,23,2,0"
                   Foreground="{StaticResource Accent}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

                                        <ComboBox Grid.Column="1"
                  x:Name="PageSizeComboBox"
                  ItemsSource="{Binding PageSizeOptions}"
                  SelectedValue="{Binding PageSize,
                                          Mode=TwoWay,
                                          UpdateSourceTrigger=PropertyChanged}"
                  SelectedValuePath="Type"
                  DisplayMemberPath="Name"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="{StaticResource TextPrimary}"
                  FontFamily="Arial"
                  FontSize="11"
                  Height="25"
                  Margin="0,25,0,0"
                  Width="100"
                  FontWeight="SemiBold"
                  VerticalContentAlignment="Center"
                  SelectionChanged="PageSizeComboBox_SelectionChanged"
                  ToolTip="Choose the CV page size"/>

                                    </Grid>

                                </StackPanel>

                            </Grid>


                            <!-- ================================================= -->
                            <!-- LIVE STATUS -->
                            <!-- ================================================= -->

                            <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                                <Ellipse Width="6"
                             Height="6"
                             Fill="#6F9D7D"
                             Margin="0,0,7,0"/>

                                <TextBlock Text="Live"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="Arial"
                               FontSize="10"/>

                            </StackPanel>

                        </Grid>

                    </Border>



                    <!-- ================================================= -->
                    <!-- DOCUMENT WORKSPACE -->
                    <!-- ================================================= -->

                    <Border Grid.Row="1"
                            Background="#EDEBE6"
                            Padding="20">

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">

                            <Grid Margin="45">

                                <ContentControl x:Name="TemplatePreview"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"/>

                            </Grid>

                        </ScrollViewer>

                    </Border>

                </Grid>

            </Border>

        </Grid>


        <!-- ========================================================= -->
        <!-- BOTTOM STATUS -->
        <!-- ========================================================= -->

        <Border Grid.Row="2"
                Background="#202A27"
                BorderBrush="#314039"
                BorderThickness="0,1,0,0">

            <Grid Margin="18,0">

                <TextBlock Text="CeeVee"
                           FontFamily="Arial"
                           FontSize="9"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0"/>


                <TextBlock Text="v1.0"
                           FontFamily="Arial"
                           FontSize="9"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>

            </Grid>

        </Border>

    </Grid>

</Window>