<Window x:Class="CeeVee.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:CeeVee="clr-namespace:CeeVee.Controls"
        Title="CeeVee"
        WindowState="Maximized"
        MinHeight="750"
        MinWidth="1150">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- COLOR PALETTE -->
        <!-- ========================================================= -->

        <!-- Main application background -->
        <SolidColorBrush x:Key="WindowBackground"
                         Color="#F4F1EA"/>

        <!-- Text -->
        <SolidColorBrush x:Key="TextPrimary"
                         Color="#24302C"/>

        <SolidColorBrush x:Key="TextSecondary"
                         Color="#69736E"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#242A27"/>

        <!-- Accent -->
        <SolidColorBrush x:Key="Accent"
                         Color="#789681"/>

        <SolidColorBrush x:Key="AccentDark"
                         Color="#526D5D"/>

        <SolidColorBrush x:Key="AccentLight"
                         Color="#E4ECE6"/>

        <!-- Borders -->
        <SolidColorBrush x:Key="BorderBrush"
                         Color="#D9DDD8"/>

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#A0A7A2"/>
        
        <SolidColorBrush x:Key="SageBrush"
                         Color="#789681"/>

        <!-- ========================================================= -->
        <!-- GREEN  BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="GreenButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="{StaticResource Accent}"/>

            <Setter Property="Foreground"
                    Value="#242A27"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="20,11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="{StaticResource AccentDark}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#455C4E"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- SECONDARY BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="SecondaryButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="18,10"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#F0F4F1"/>

                                <Setter Property="BorderBrush"
                                        Value="{StaticResource Accent}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- EDITOR TEXTBOX -->
        <!-- ========================================================= -->

        <Style x:Key="EditorTextBox"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>

            <Setter Property="BorderBrush"
                    Value="#D5DAD6"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="12,9"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Margin"
                    Value="0,5,0,16"/>

            <Setter Property="CaretBrush"
                    Value="{StaticResource Accent}"/>

        </Style>


        <!-- ========================================================= -->
        <!-- MULTILINE TEXTBOX -->
        <!-- ========================================================= -->

        <Style x:Key="EditorMultiLineTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource EditorTextBox}">

            <Setter Property="Height"
                    Value="115"/>

            <Setter Property="AcceptsReturn"
                    Value="True"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Top"/>

            <Setter Property="Padding"
                    Value="12"/>

        </Style>


        <!-- ========================================================= -->
        <!-- FIELD LABEL -->
        <!-- ========================================================= -->

        <Style x:Key="FieldLabel"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondary}"/>

            <Setter Property="FontSize"
                    Value="10"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Margin"
                    Value="0,0,0,3"/>

        </Style>


        <!-- ========================================================= -->
        <!-- SMALL NAVIGATION BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="SmallNavigationButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="36"/>

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondary}"/>

            <Setter Property="BorderBrush"
                    Value="#D5DAD6"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="{StaticResource AccentLight}"/>

                                <Setter Property="Foreground"
                                        Value="{StaticResource AccentDark}"/>

                                <Setter Property="BorderBrush"
                                        Value="{StaticResource Accent}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- ADD BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="AddButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#EEF4F0"/>

            <Setter Property="Foreground"
                    Value="{StaticResource AccentDark}"/>

            <Setter Property="BorderBrush"
                    Value="#C9D8CD"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="14,8"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#E0EBE3"/>

                                <Setter Property="BorderBrush"
                                        Value="{StaticResource Accent}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ========================================================= -->
        <!-- COMBOBOX ITEMS -->
        <!-- ========================================================= -->

        <Style TargetType="ComboBoxItem">

            <Setter Property="Foreground"
                    Value="#24302C"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Padding"
                    Value="10,7"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#EAF0EC"/>

                    <Setter Property="Foreground"
                            Value="#24302C"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#DCE8DF"/>

                    <Setter Property="Foreground"
                            Value="#24302C"/>

                </Trigger>

            </Style.Triggers>

        </Style>


    </Window.Resources>


    <!-- ============================================================= -->
    <!-- ROOT -->
    <!-- ============================================================= -->

    <Grid Background="{StaticResource WindowBackground}">

        <Grid.RowDefinitions>

            <RowDefinition Height="62"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="36"/>

        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="72"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- ========================================= -->
                <!-- LOGO -->
                <!-- ========================================= -->

                <StackPanel Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="25,0,0,0">


                    <!-- LOGO MARK -->

                    <Grid Width="34"
                          Height="34"
                          Margin="0,0,11,0">

                        <!-- Outer C -->

                        <Ellipse Stroke="{StaticResource SageBrush}"
                                 StrokeThickness="3"/>

                        <!-- Open part of C -->

                        <Rectangle Width="12"
                                   Height="18"
                                   Fill="White"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>

                        <!-- Document line -->

                        <Border Width="11"
                                Height="2"
                                Background="{StaticResource SageBrush}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="9,0,0,0"/>

                    </Grid>


                    <!-- WORDMARK -->

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="CeeVee"
                                   FontFamily="Georgia"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Text="RESUME STUDIO"
                                   FontFamily="Arial"
                                   FontSize="7"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="1,0,0,0"/>

                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- MAIN AREA -->
        <!-- ========================================================= -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="430"/>

                <ColumnDefinition Width="18"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ===================================================== -->
            <!-- LEFT EDITOR -->
            <!-- ===================================================== -->

            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Margin="18,18,0,18">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- ================================================= -->
                    <!-- EDITOR HEADER -->
                    <!-- ================================================= -->

                    <Border Grid.Row="0"
                            Background="#FFFFFF"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="22,18">

                        <StackPanel>

                            <TextBlock Text="Build Cariculum Vitae"
                                       FontFamily="Georgia"
                                       FontSize="25"
                                       Foreground="{StaticResource TextPrimary}"/>

                            <TextBlock x:Name="StepDescription"
                                       Text="Let's start with your personal information."
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"
                                       Margin="0,7,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- ================================================= -->
                    <!-- STEPS -->
                    <!-- ================================================= -->

                    <Border Grid.Row="1"
                            Background="#F8F7F3"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="18,14">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <!-- STEP 1 -->

                            <StackPanel Grid.Column="0"
                                        HorizontalAlignment="Center">

                                <Border x:Name="Step1Circle"
                                        Width="27"
                                        Height="27"
                                        CornerRadius="14"
                                        Background="{StaticResource Accent}">

                                    <TextBlock Text="1"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock Text="Personal"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>

                            </StackPanel>


                            <!-- STEP 2 -->

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Center">

                                <Border x:Name="Step2Circle"
                                        Width="27"
                                        Height="27"
                                        CornerRadius="14"
                                        Background="#E1E5E1">

                                    <TextBlock Text="2"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock Text="Summary"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>

                            </StackPanel>


                            <!-- STEP 3 -->

                            <StackPanel Grid.Column="2"
                                        HorizontalAlignment="Center">

                                <Border x:Name="Step3Circle"
                                        Width="27"
                                        Height="27"
                                        CornerRadius="14"
                                        Background="#E1E5E1">

                                    <TextBlock Text="3"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock Text="Work"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>

                            </StackPanel>


                            <!-- STEP 4 -->

                            <StackPanel Grid.Column="3"
                                        HorizontalAlignment="Center">

                                <Border x:Name="Step4Circle"
                                        Width="27"
                                        Height="27"
                                        CornerRadius="14"
                                        Background="#E1E5E1">

                                    <TextBlock Text="4"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock Text="Education"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>

                            </StackPanel>


                            <!-- STEP 5 -->

                            <StackPanel Grid.Column="4"
                                        HorizontalAlignment="Center">

                                <Border x:Name="Step5Circle"
                                        Width="27"
                                        Height="27"
                                        CornerRadius="14"
                                        Background="#E1E5E1">

                                    <TextBlock Text="5"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock Text="Skill &amp; Lang"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>

                            </StackPanel>


                            <!-- STEP 6 -->

                            <StackPanel Grid.Column="5"
                                        HorizontalAlignment="Center">

                                <Border x:Name="Step6Circle"
                                        Width="27"
                                        Height="27"
                                        CornerRadius="14"
                                        Background="#E1E5E1">

                                    <TextBlock Text="6"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock Text="Optional"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>

                            </StackPanel>


                            <!-- STEP 7 -->

                            <StackPanel Grid.Column="6"
                                        HorizontalAlignment="Center">

                                <Border x:Name="Step7Circle"
                                        Width="27"
                                        Height="27"
                                        CornerRadius="14"
                                        Background="#E1E5E1">

                                    <TextBlock Text="7"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock Text="Finish"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- FORM -->
                    <!-- ================================================= -->

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <Grid Margin="22,22,22,18">


                            <!-- ================================================= -->
                            <!-- PERSONAL -->
                            <!-- ================================================= -->

                            <StackPanel x:Name="PersonalStep">

                                <TextBlock Text="PERSONAL INFORMATION"
                                           Foreground="{StaticResource AccentDark}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           FontFamily="Georgia"
                                           Margin="0,0,0,18"/>


                                <TextBlock Text="First name"
                                           Style="{StaticResource FieldLabel}"/>

                                <TextBox Text="{Binding PersonalDetails.FullName,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditorTextBox}"/>


                                <TextBlock Text="Last name"
                                           Style="{StaticResource FieldLabel}"/>

                                <TextBox Text="{Binding PersonalDetails.LastName,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditorTextBox}"/>


                                <TextBlock Text="Professional title"
                                           Style="{StaticResource FieldLabel}"/>

                                <TextBox Text="{Binding PersonalDetails.Profession,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditorTextBox}"/>


                                <TextBlock Text="Email"
                                           Style="{StaticResource FieldLabel}"/>

                                <TextBox Text="{Binding PersonalDetails.Email,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditorTextBox}"/>


                                <TextBlock Text="Phone"
                                           Style="{StaticResource FieldLabel}"/>

                                <TextBox Text="{Binding PersonalDetails.Phone,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditorTextBox}"/>


                                <TextBlock Text="Location"
                                           Style="{StaticResource FieldLabel}"/>

                                <TextBox Text="{Binding PersonalDetails.Location,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditorTextBox}"/>


                                <TextBlock Text="LinkedIn"
                                           Style="{StaticResource FieldLabel}"/>

                                <TextBox Text="{Binding PersonalDetails.LinkedIn,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditorTextBox}"/>


                                <TextBlock Text="Github/Portfolio"
                                           Style="{StaticResource FieldLabel}"/>

                                <TextBox Text="{Binding PersonalDetails.Github,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditorTextBox}"/>

                            </StackPanel>


                            <!-- ================================================= -->
                            <!-- PROFILE -->
                            <!-- ================================================= -->

                            <StackPanel x:Name="ProfileStep"
                                        Visibility="Collapsed">

                                <TextBlock Text="PROFESSIONAL SUMMARY"
                                           Foreground="{StaticResource AccentDark}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           FontFamily="Georgia"
                                           Margin="0,0,0,18"/>



                                <TextBox Text="{Binding Profile.Summary,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource EditorMultiLineTextBox}"/>


                                <TextBlock Text="Write a concise introduction about your experience, strengths and career direction."
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           LineHeight="17"/>

                            </StackPanel>


                            <!-- ================================================= -->
                            <!-- EXPERIENCE -->
                            <!-- ================================================= -->

                            <StackPanel x:Name="ExperienceStep"
                                        Visibility="Collapsed">

                                <TextBlock Text="EXPERIENCE"
                                           Foreground="{StaticResource AccentDark}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           FontFamily="Georgia"
                                           Margin="0,0,0,12"/>

                                <Button x:Name="AddFirstExperienceButton"
                                        Content="+ Add Education"
                                        Style="{StaticResource AddButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,14"
                                        Click="AddExperience_Click"/>

                                <Border x:Name="ExperienceEditorPanel"
                                        Background="#F8F7F3"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="16">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>


                                        <!-- HEADER -->

                                        <Grid Grid.Row="0"
                                              Margin="0,0,0,15">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>


                                            <TextBlock x:Name="ExperienceCounter"
                                                       Grid.Column="0"
                                                       Text="Experience 1 of 1"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontFamily="Georgia"
                                                       FontSize="17"
                                                       VerticalAlignment="Center"/>


                                            <Button Grid.Column="1"
                                                    Content="×"
                                                    Width="28"
                                                    Height="28"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    Foreground="{StaticResource TextSecondary}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    FontSize="18"
                                                    FontWeight="Normal"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Remove this experience"
                                                    Click="RemoveExperience_Click"/>

                                        </Grid>


                                        <!-- CONTENT -->

                                        <StackPanel Grid.Row="1">

                                            <TextBlock Text="Job title"
                                                       Style="{StaticResource FieldLabel}"/>

                                            <TextBox x:Name="ExperienceJobTitle"
                                                     Style="{StaticResource EditorTextBox}"
                                                     Text="{Binding JobTitle,
                                                                    Mode=TwoWay,
                                                                    UpdateSourceTrigger=PropertyChanged}"/>


                                            <TextBlock Text="Company"
                                                       Style="{StaticResource FieldLabel}"/>

                                            <TextBox x:Name="ExperienceCompany"
                                                     Style="{StaticResource EditorTextBox}"
                                                     Text="{Binding Company,
                                                                    Mode=TwoWay,
                                                                    UpdateSourceTrigger=PropertyChanged}"/>


                                            <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>


                                                <StackPanel Grid.Column="0">

                                                    <TextBlock Text="Start date"
                                                               Style="{StaticResource FieldLabel}"/>

                                                    <CeeVee:MonthYearPicker
                                                        x:Name="ExperienceStartDate"
                                                        SelectedMonth="{Binding StartDate,
                                                                                Mode=TwoWay,
                                                                                UpdateSourceTrigger=PropertyChanged}"
                                                        Height="40"
                                                        Margin="0,5,0,14"/>

                                                </StackPanel>


                                                <StackPanel Grid.Column="2">

                                                    <TextBlock Text="End date"
                                                               Style="{StaticResource FieldLabel}"/>

                                                    <CeeVee:MonthYearPicker
                                                        x:Name="ExperienceEndDate"
                                                        SelectedMonth="{Binding EndDate,
                                                                                Mode=TwoWay,
                                                                                UpdateSourceTrigger=PropertyChanged}"
                                                        Height="40"
                                                        Margin="0,5,0,14"/>

                                                </StackPanel>

                                            </Grid>


                                            <CheckBox x:Name="ExperiencePresent"
                                                      Content="I currently work here"
                                                      IsChecked="{Binding IsPresent,
                                                                          Mode=TwoWay,
                                                                          UpdateSourceTrigger=PropertyChanged}"
                                                      Checked="ExperiencePresent_Checked"
                                                      Unchecked="ExperiencePresent_Unchecked"
                                                      Margin="0,0,0,8"/>


                                            <TextBlock x:Name="ExperienceDateValidationText"
                                                       Foreground="#B45F52"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,12"/>


                                            <TextBlock Text="Description"
                                                       Style="{StaticResource FieldLabel}"/>

                                            <TextBox x:Name="ExperienceDescription"
                                                     Style="{StaticResource EditorMultiLineTextBox}"
                                                     Text="{Binding Description,
                                                                    Mode=TwoWay,
                                                                    UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"/>

                                        </StackPanel>

                                    </Grid>

                                </Border>


                                <Grid x:Name="ExperienceNavigationPanel"
                                      Visibility="Collapsed"
                                      Margin="0,14,0,25">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

